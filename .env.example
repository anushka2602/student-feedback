# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Server only. Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Signs login cookies. Any long random string (openssl rand -base64 32).
# If omitted, the service role key is used as the signing secret.
SESSION_SECRET=

# Password reset emails (resend.com)
RESEND_API_KEY=
# Must be a verified sender/domain in Resend. The default only delivers to your own Resend account email.
EMAIL_FROM="Student Feedback <onboarding@resend.dev>"